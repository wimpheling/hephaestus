#!/bin/sh
set -eu

# All paths are fixed by the VM adapter. The repository controls only the
# read-only Dockerfile/context contents; no argument is evaluated as shell.
readonly_source=/workspace/source
readonly_base=/workspace/heph-base
writable_output=/workspace/candidate

export HOME=/tmp/heph-agent-home
export XDG_RUNTIME_DIR=/tmp/heph-agent-runtime
mkdir -p "$HOME" "$XDG_RUNTIME_DIR"
chmod 0700 "$HOME" "$XDG_RUNTIME_DIR"

# Platform root filesystems are immutable. Keep Buildah's private metadata in
# the VM's tmpfs rather than allowing it to select /var/lib or /run from that
# immutable root. The paths are fresh for this one-shot VM and never mounted
# back to the host.
buildah_root="$HOME/buildah-root"
buildah_runroot="$XDG_RUNTIME_DIR/buildah-runroot"
mkdir -p "$buildah_root" "$buildah_runroot"
buildah_local() {
    buildah --storage-driver vfs --root "$buildah_root" --runroot "$buildah_runroot" "$@"
}

rm -rf "$writable_output"/*
# The approved base is an OCI layout with a generated immutable reference
# name, not a mutable `latest` tag. Import that one descriptor into Buildah's
# private VM-local store and assign the reserved Dockerfile name afterwards.
base_tag=$(grep --only-matching --extended-regexp 'heph-sha256-[0-9a-f]{64}' \
    "$readonly_base/index.json" | sort --unique)
[ "$(printf '%s\n' "$base_tag" | wc --lines)" -eq 1 ]
if ! base_image=$(buildah_local pull --quiet "oci:${readonly_base}:${base_tag}"); then
    # This fixed marker is safe operational telemetry. Buildah's raw output is
    # deliberately never retained by the host.
    printf '%s\n' 'HEPH_OCI_FAILURE=base-import' >&2
    exit 125
fi
if ! buildah_local tag "$base_image" heph-base; then
    printf '%s\n' 'HEPH_OCI_FAILURE=base-alias' >&2
    exit 125
fi
# Buildah 1.33 rejects `--network none` with `--isolation chroot`. The VM
# specification is the authoritative boundary and has NetworkMode::Disabled,
# so the guest cannot obtain a network interface regardless of Dockerfile
# instructions; `--pull-never` separately rejects image acquisition.
if ! buildah_local bud \
    --isolation chroot \
    --pull-never \
    --format oci \
    --layers=false \
    --file "$1" \
    --tag hephaestus-repository-output \
    "$2"; then
    printf '%s\n' 'HEPH_OCI_FAILURE=dockerfile-build' >&2
    exit 125
fi
if ! buildah_local push --format oci hephaestus-repository-output "oci:${writable_output}:latest"; then
    printf '%s\n' 'HEPH_OCI_FAILURE=layout-export' >&2
    exit 125
fi
